# 统一换行符处理：仓库内一律使用 LF，避免跨平台差异。
* text=auto eol=lf

# Shell 脚本必须使用 LF，否则在 Linux 上无法执行。
*.sh text eol=lf
run.sh text eol=lf

# Windows 批处理使用 CRLF。
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换。
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
*.db binary

# 以下文件不参与语言统计。
data/** linguist-vendored
web/assets/*.css linguist-detectable=false
