# AutoDeploy 反向代理示例。
#
# 用途：把 AutoDeploy 暴露在 443 端口，并为会话 Cookie 提供 HTTPS。
# 使用前请替换 server_name 与证书路径，然后在「设置」页面勾选
# 「仅通过 HTTPS 发送会话 Cookie」和「信任反向代理的 X-Forwarded-For」。
#
# 注意：部署任务可以执行任意脚本，控制台等同于服务器 root 权限，
# 请勿直接暴露到公网而不加访问限制。

upstream autodeploy_backend {
    server 127.0.0.1:8770;
    keepalive 16;
}

server {
    listen 80;
    server_name deploy.example.com;
    # 强制跳转到 HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name deploy.example.com;

    ssl_certificate     /etc/letsencrypt/live/deploy.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/deploy.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    # 部署日志可能很长，放宽上传/下载限制并关闭响应缓冲。
    client_max_body_size 32m;
    proxy_buffering off;
    proxy_read_timeout 3600s;   # 长时间运行的部署需要更长的读超时
    proxy_send_timeout 3600s;

    # 即便有 HTTPS，也建议再加一层访问控制。
    # auth_basic           "AutoDeploy";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        proxy_pass http://autodeploy_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }

    # 健康检查不需要认证，便于监控使用。
    location /api/health {
        proxy_pass http://autodeploy_backend;
        proxy_set_header Host $host;
        access_log off;
    }
}
